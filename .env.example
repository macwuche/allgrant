APP_NAME=AllGrant
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-replit-url.repl.co

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase PostgreSQL connection
DB_CONNECTION=pgsql
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
# Keeps the PDO connection to Postgres alive across requests on the same PHP
# worker (PHP-FPM) instead of reconnecting every page load. See
# config/database.php. Set to false only if the pooler's connection limit
# starts getting exhausted.
DB_PERSISTENT=true

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

STRIPE_KEY=
STRIPE_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MERCHANT_EMAIL=

FLUTTERWAVE_SECRET_KEY=

TWILIO_SID=
TWILIO_AUTH_TOKEN=

GOOGLE_RECAPTCHA_SECRET=

NEXMO_KEY=
NEXMO_SECRET=
